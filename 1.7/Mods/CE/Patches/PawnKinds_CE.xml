<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ==================== CIVILIANS & NON-FIGHTERS ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Settler"
      or defName="Offworlder_Rough_Settler"
      or defName="Offworlder_Civil_Trader"
      or defName="Offworlder_Rough_Trader"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>1</min>
          <max>2</max>
        </primaryMagazineCount>
      </li>
    </value>
  </Operation>

  <!-- ==================== REPRESENTATIVES ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Representative"
      or defName="Offworlder_Rough_Representative"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>2</min>
          <max>4</max>
        </primaryMagazineCount>
      </li>
    </value>
  </Operation>

  <!-- ==================== COMMANDERS ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Commander"
      or defName="Offworlder_Rough_Commander"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>6</min>
          <max>8</max>
        </primaryMagazineCount>
        <forcedSidearm>
          <sidearmMoney>
            <min>0</min>
            <max>10000</max>
          </sidearmMoney>
          <weaponTags>
            <li>BNF_Commander</li>
          </weaponTags>
          <magazineCount>
            <min>3</min>
            <max>5</max>
          </magazineCount>
        </forcedSidearm>
      </li>
    </value>
  </Operation>

  <!-- ==================== LIGHT INFANTRY ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Infantry"
      or defName="Offworlder_Rough_Infantry"
      or defName="Offworlder_Civil_Medic"
      or defName="Offworlder_Rough_Medic"
      or defName="Offworlder_Civil_Engineer"
      or defName="Offworlder_Rough_Engineer"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>4</min>
          <max>6</max>
        </primaryMagazineCount>
        <forcedSidearm>
          <sidearmMoney>
            <min>0</min>
            <max>10000</max>
          </sidearmMoney>
          <weaponTags>
            <li>IndustrialMeleeBasic</li>
          </weaponTags>
        </forcedSidearm>
      </li>
    </value>
  </Operation>

  <!-- ==================== RANGERS ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Ranger"
      or defName="Offworlder_Rough_Ranger"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>4</min>
          <max>6</max>
        </primaryMagazineCount>
        <forcedSidearm>
          <sidearmMoney>
            <min>0</min>
            <max>10000</max>
          </sidearmMoney>
          <weaponTags>
            <li>BNF_Ranger</li>
          </weaponTags>
          <magazineCount>
            <min>2</min>
            <max>4</max>
          </magazineCount>
        </forcedSidearm>
      </li>
    </value>
  </Operation>

  <!-- ==================== HEAVY INFANTRY ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Heavy_Infantry"
      or defName="Offworlder_Rough_Heavy_Infantry"
      or defName="Offworlder_Civil_Heavy_Medic"
      or defName="Offworlder_Rough_Heavy_Medic"
      or defName="Offworlder_Civil_Heavy_Engineer"
      or defName="Offworlder_Rough_Heavy_Engineer"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>6</min>
          <max>8</max>
        </primaryMagazineCount>
        <forcedSidearm>
          <sidearmMoney>
            <min>0</min>
            <max>10000</max>
          </sidearmMoney>
          <weaponTags>
            <li>IndustrialMeleeBasic</li>
          </weaponTags>
        </forcedSidearm>
      </li>
    </value>
  </Operation>

  <!-- ==================== SHOCKTROOPERS ==================== -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/PawnKindDef[defName="Offworlder_Civil_Trench_Raider"
      or defName="Offworlder_Rough_Trench_Raider"
      or defName="Offworlder_Civil_Trench_Shocktrooper"
      or defName="Offworlder_Rough_Trench_Shocktrooper"]</xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>6</min>
          <max>8</max>
        </primaryMagazineCount>
        <forcedSidearm>
          <sidearmMoney>
            <min>0</min>
            <max>10000</max>
          </sidearmMoney>
          <weaponTags>
            <li>BNF_Raider</li>
          </weaponTags>
        </forcedSidearm>
      </li>
    </value>
  </Operation>

</Patch>
