  <!-- ==================== HELMET FUNCTIONAL BONUSES ==================== -->

  <!-- Thermal helmets: NightVision only -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="KP_Light_Flak_Helmet_Thermal" or defName="KP_Heavy_Flak_Helmet_Thermal"]/statBases</xpath>
    <value>
      <NightVisionEfficiency_Apparel>0.75</NightVisionEfficiency_Apparel>
    </value>
  </Operation>

  <!-- Faceshields: PartialArmorExt on Eye/Nose/Jaw -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="KP_Light_Flak_Helmet_Faceshield" or defName="KP_Heavy_Flak_Helmet_Faceshield"]</xpath>
    <value>
      <li Class="CombatExtended.PartialArmorExt">
        <stats>
          <li>
            <ArmorRating_Sharp>0.85</ArmorRating_Sharp>
            <parts>
              <li>Eye</li>
              <li>Nose</li>
              <li>Jaw</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Blunt>0.85</ArmorRating_Blunt>
            <parts>
              <li>Eye</li>
              <li>Nose</li>
              <li>Jaw</li>
            </parts>
          </li>
        </stats>
      </li>
    </value>
  </Operation>

  <!-- Gasmasks: NightVision + immuneToToxGasExposure + SmokeSensitivity + PartialArmorExt -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="BNF_FlakHelmetL_Gasmask" or defName="BNF_FlakHelmetH_Gasmask"]/statBases</xpath>
