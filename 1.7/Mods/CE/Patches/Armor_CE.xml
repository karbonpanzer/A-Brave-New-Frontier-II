    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="BNF_FlakHelmetL_Gasmask" or defName="BNF_FlakHelmetH_Gasmask"]/apparel</xpath>
    <value>
