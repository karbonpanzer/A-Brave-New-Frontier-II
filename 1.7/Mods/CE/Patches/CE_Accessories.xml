<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="BNFII_AccessoryBase"]/apparel/layers/li[.="Shell"]</xpath>
		<value>
			<li>Webbing</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_HeavyInfantryWebbing"]/statBases</xpath>
		<value>
			<Bulk>6</Bulk>
			<WornBulk>3</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BNFII_HeavyInfantryWebbing"]/equippedStatOffsets/RangedCooldownFactor</xpath>
		<value>
			<ReloadSpeed>0.25</ReloadSpeed>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_HeavyInfantryWebbing"]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>25</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_ScoutWebbing"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
			<WornBulk>1.5</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_ScoutWebbing"]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>15</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_ShocktrooperWebbing"]/statBases</xpath>
		<value>
			<Bulk>6</Bulk>
			<WornBulk>3</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_ShocktrooperWebbing"]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>15</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BNFII_ShocktrooperWebbing"]/verbs</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>throw frag grenade</label>
					<verbClass>CombatExtended.Verb_LaunchProjectileStaticCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<onlyManualCast>true</onlyManualCast>
					<range>10</range>
					<minRange>4</minRange>
					<warmupTime>1.5</warmupTime>
					<noiseRadius>4</noiseRadius>
					<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
					<soundCast>ThrowGrenade</soundCast>
					<drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<defaultProjectile>Proj_GrenadeFrag</defaultProjectile>
					<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
					<ai_AvoidFriendlyFireRadius>7</ai_AvoidFriendlyFireRadius>
					<minRangeInCover>2</minRangeInCover>
				</li>
			</verbs>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_InfantryBelt"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
			<WornBulk>1.5</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BNFII_InfantryBelt"]/equippedStatOffsets/RangedCooldownFactor</xpath>
		<value>
			<ReloadSpeed>0.15</ReloadSpeed>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_InfantryBelt"]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>20</CarryBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_EngineerBelt" or defName="BNFII_MedicBelt"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
			<WornBulk>1.5</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="BNFII_EngineerBelt" or defName="BNFII_MedicBelt"]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>15</CarryBulk>
		</value>
	</Operation>

</Patch>