<?xml version='1.0' encoding='utf-8'?>
<Defs>
	
	<FactionDef ParentName="PlayerFactionBase">
		<defName>BNFII_Frontier_Player</defName>
		<label>Colonial Settlers</label>
		<description>A Frontier group sent to colonize this world by choice.</description>
		<colorSpectrum>
            <li>(0, 0.737, 0.847)</li>
		</colorSpectrum>
		<isPlayer>true</isPlayer>
		<basicMemberKind>BNFII_Frontier_Player</basicMemberKind>
		<pawnSingular>Frontier</pawnSingular>
		<pawnsPlural>Frontiers</pawnsPlural>
		<techLevel>Industrial</techLevel>
		<allowedCultures>
			<li>Astropolitan</li>
		</allowedCultures>
		<factionNameMaker>BNF_Faction_Civil</factionNameMaker>
		<settlementNameMaker>BNF_Settlement_Civil</settlementNameMaker>
		<backstoryFilters>
		  <li>
			<categories>
			  <li>Frontier</li>
			  <li>Outlander</li>
			</categories>
		  </li>
		</backstoryFilters>
		<apparelStuffFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</apparelStuffFilter>
		<factionIconPath>BNFII/UI/FactionIcons/FrontierPlayerOutpostIII</factionIconPath>
		<startingResearchTags>
			<li>ClassicStart</li>
		</startingResearchTags>
		<startingTechprintsResearchTags>
			<li>ClassicStart</li>
			<li>ClassicStartTechprints</li>
		</startingTechprintsResearchTags>
	</FactionDef>

	<FactionDef ParentName="FactionBase">
		<defName>BNFII_Frontier_Civil</defName>
		<label>civil colonial expedition</label>
		<description>These people are a new arrival to this world, arriving from various worlds seeking opportunity. Some have spent years to centuries in their travels, limiting them to the technology of their time but many have brought technology from their homeworlds.\n\nThey are concerned with their colonies but desire strong connections with the people of their world, pursing trade, exploration, and peace with their neighbors.</description>
		<pawnSingular>expeditionary</pawnSingular>
		<pawnsPlural>expeditionaries</pawnsPlural>
		<listOrderPriority>13</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxCountAtGameStart>1</maxCountAtGameStart>
		<canMakeRandomly>true</canMakeRandomly>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>representative</leaderTitle>
		<factionIconPath>BNFII/UI/FactionIcons/FrontierCivilOutpostIII</factionIconPath>
		<factionNameMaker>BNF_Faction_Civil</factionNameMaker>
		<settlementNameMaker>BNF_Settlement_Civil</settlementNameMaker>
		<colorSpectrum>
			<li>(0.80, 0.80, 0.95)</li>
		</colorSpectrum>
		<permanentEnemy>false</permanentEnemy>
		<techLevel>Industrial</techLevel>
		<allowedCultures>
			<li>Astropolitan</li>
		</allowedCultures>
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
		</requiredMemes>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
		</disallowedMemes>
		<backstoryFilters>
		  <li>
			<categories>
			  <li>Frontier</li>
			  <li>Outlander</li>
			</categories>
		  </li>
		</backstoryFilters>
		<apparelStuffFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Leather_Plain</li>
			</thingDefs>
		</apparelStuffFilter>
		<xenotypeSet>
			<xenotypeChances>
				<Starjack MayRequire="Ludeon.RimWorld.Odyssey">0.12</Starjack>
				<Hussar MayRequire="Ludeon.RimWorld.Biotech">0.06</Hussar>
				<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0.04</Dirtmole>
				<Impid MayRequire="Ludeon.RimWorld.Biotech">0.02</Impid>
				<Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.02</Pigskin>
				<Yttakin MayRequire="Ludeon.RimWorld.Biotech">0.02</Yttakin>
			</xenotypeChances>
		</xenotypeSet>
		<allowedArrivalTemperatureRange>-40~50</allowedArrivalTemperatureRange>
		<raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
		<caravanTraderKinds>
			<li>Caravan_Frontier_BulkGoods</li>
			<li>Caravan_Frontier_ArmsDealer</li>
			<li>Caravan_Frontier_Exotic</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Frontier_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Base_Frontier_Standard</li>
		</baseTraderKinds>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,      40)</li>
				<li>(70,     60)</li>
				<li>(700,   120)</li>
				<li>(1300,  200)</li>
				<li>(100000,10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers>
		  <li>
			<kindDef>Combat</kindDef>
			<commonality>45</commonality>
			<options>
			  <BNFII_Civil_Militia>10</BNFII_Civil_Militia>
			  <BNFII_Civil_Infantry>18</BNFII_Civil_Infantry>
			  <BNFII_Civil_Heavy_Infantry>19</BNFII_Civil_Heavy_Infantry>
			  <BNFII_Civil_Ranger>7</BNFII_Civil_Ranger>
			  <BNFII_Civil_Medic>3</BNFII_Civil_Medic>
			  <BNFII_Civil_Engineer>3</BNFII_Civil_Engineer>
			  <BNFII_Civil_Commander>3</BNFII_Civil_Commander>
			</options>
		  </li>

		  <li>
			<kindDef>Peaceful</kindDef>
			<commonality>20</commonality>
			<options>
			  <BNFII_Civil_Settler>12</BNFII_Civil_Settler>
			  <BNFII_Civil_Militia>8</BNFII_Civil_Militia>
			  <BNFII_Civil_Trader>8</BNFII_Civil_Trader>
			  <BNFII_Civil_Representative>2</BNFII_Civil_Representative>
			  <BNFII_Civil_Ranger>4</BNFII_Civil_Ranger>
			  <BNFII_Civil_Infantry>6</BNFII_Civil_Infantry>
			  <BNFII_Civil_Medic>2</BNFII_Civil_Medic>
			  <BNFII_Civil_Engineer>2</BNFII_Civil_Engineer>
			  <BNFII_Civil_Commander>1</BNFII_Civil_Commander>
			</options>
		  </li>

		  <li>
			<kindDef>Trader</kindDef>
			<traders>
			  <BNFII_Civil_Trader>1</BNFII_Civil_Trader>
			</traders>
			<carriers>
			  <Muffalo>5</Muffalo>
			</carriers>
			<guards>
			  <BNFII_Civil_Militia>25</BNFII_Civil_Militia>
			  <BNFII_Civil_Infantry>18</BNFII_Civil_Infantry>
			  <BNFII_Civil_Heavy_Infantry>12</BNFII_Civil_Heavy_Infantry>			  
			  <BNFII_Civil_Ranger>8</BNFII_Civil_Ranger>
			  <BNFII_Civil_Commander>3</BNFII_Civil_Commander>
			</guards>
		  </li>

		  <li>
			<kindDef>Settlement</kindDef>
			<options>
			  <BNFII_Civil_Settler>20</BNFII_Civil_Settler>
			  <BNFII_Civil_Militia>10</BNFII_Civil_Militia>
			  <BNFII_Civil_Engineer>4</BNFII_Civil_Engineer>
			  <BNFII_Civil_Medic>4</BNFII_Civil_Medic>
			  <BNFII_Civil_Infantry>8</BNFII_Civil_Infantry>
			  <BNFII_Civil_Ranger>6</BNFII_Civil_Ranger>
			  <BNFII_Civil_Representative>1</BNFII_Civil_Representative>
			  <BNFII_Civil_Commander>3</BNFII_Civil_Commander>
			</options>
		  </li>
		</pawnGroupMakers>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>25</configurationListOrderPriority>
	</FactionDef>

	<FactionDef ParentName="FactionBase">
		<defName>BNFII_Frontier_Rough</defName>
		<label>rough colonial expedition</label>
		<description>A loose confederation of pirates, criminals, and all manner of unsavory person arrived to this world in search of resources to exploit. Having spent years travelling to this world in a stolen fleet with stolen technology, they are limited to the technology of what they have pilfered in their years of travel.\n\nThey are concerned with what loot they are able to aquire from the inhabitants of this world. they prefer violence to diplomacy and will kill to obtain what they want.</description>
		<pawnSingular>expeditionary</pawnSingular>
		<pawnsPlural>expeditionaries</pawnsPlural>
		<listOrderPriority>14</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxCountAtGameStart>1</maxCountAtGameStart>
