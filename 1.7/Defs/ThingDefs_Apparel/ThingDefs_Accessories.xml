<?xml version='1.0' encoding='utf-8'?>
<Defs>

	<!-- Accessory Parent -->
	<ThingDef Name="BNFII_AccessoryBase" ParentName="ApparelMakeableBase" Abstract="True">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>1</Mass>
			<StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Waist</li>
			</bodyPartGroups>
			<layers>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<useWornGraphicMask>True</useWornGraphicMask>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.50,0.5,0.36)</only>
				</li>
				<li>
					<weight>6</weight>
					<only>(0.40,0.57,0.40)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.38,0.36,0.20)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.29,0.32,0.12)</only>
				</li>
			</options>
		</colorGenerator>
		<thingCategories Inherit="False">
			<li>ApparelMisc</li>
		</thingCategories> 		
		<tradeTags>
			<li>Clothing</li>
			<li>BNFII_Utility</li>
		</tradeTags>
	</ThingDef>

	<!-- Webbing -->
	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_HeavyInfantryWebbing</defName>
		<label>heavy infantry webbing</label>
		<description>A heavy webbing system for keeping large amounts of spare munitions close at hand, greatly reducing their ranged weapons cool down but weighing more. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_InfantryKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/HeavyInfantryBandoleer/HeavyInfantryBandoleer</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<RangedCooldownFactor>-0.35</RangedCooldownFactor>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/HeavyInfantryBandoleer/HeavyInfantryBandoleer</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_InfantryAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_ScoutWebbing</defName>
		<label>scout webbing</label>
		<description>A heavy webbing system for allowing greater manuevability, greatly increasing the foraging and stelath of the wearer but weighing more. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_ScoutKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/ScoutWebbing/ScoutWebbing</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<HuntingStealth>0.40</HuntingStealth>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/ScoutWebbing/ScoutWebbing</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_ScoutAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_ShocktrooperWebbing</defName>
		<label>shocktrooper webbing</label>
		<description>A heavy webbing system for keeping large amounts of explosives and combat drugs close at hand, greatly increasing their combat skills but weighing more. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_ShocktrooperKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<PainShockThreshold>0.20</PainShockThreshold>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_ShocktrooperAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>8</maxCharges>
				<ammoDef>Weapon_GrenadeFrag</ammoDef>
				<ammoCountToRefill>1</ammoCountToRefill>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>frag</chargeNoun>
				<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li>
				<label>throw frag grenade</label>
				<verbClass>Verb_LaunchProjectileStatic</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<onlyManualCast>True</onlyManualCast>
				<range>12.9</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<warmupTime>1.5</warmupTime>
				<noiseRadius>4</noiseRadius>
				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
				<soundCast>ThrowGrenade</soundCast>
				<drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>Proj_GrenadeFrag</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
	</ThingDef>

	<!-- Belts -->
	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_InfantryBelt</defName>
		<label>infantry pouches</label>
		<description>A belt system for keeping spare munitions close at hand, reducing their ranged weapons cool down. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_InfantryKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/InfantryBelt/InfantryBelt</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>2000</WorkToMake>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<RangedCooldownFactor>-0.2</RangedCooldownFactor>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/InfantryBelt/InfantryBelt</wornGraphicPath>
			<tags>
				<li>BNFII_InfantryAccessories</li>
			</tags>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_EngineerBelt</defName>
		<label>engineer belt</label>
		<description>A belt system for keeping spare tools close at hand, reducing their repair time in the field. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_SupportKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/EngineerBelt/EngineerBelt</texPath>
		</graphicData>
		<costList>
			<Steel>30</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>2500</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<FixBrokenDownBuildingSuccessChance>0.1</FixBrokenDownBuildingSuccessChance>
			<ConstructionSpeed>0.15</ConstructionSpeed>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/EngineerBelt/EngineerBelt</wornGraphicPath>
			<tags>
				<li>BNFII_EngineerAccessories</li>
			</tags>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_MedicBelt</defName>
		<label>medic belt</label>
		<description>A belt system for keeping spare medical supplies close at hand, improving their tending quality and speed. It doesn't cover the body, so it can be worn happily by nudists and yttakin.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_SupportKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/MedicBelt/MedicBelt</texPath>
		</graphicData>
		<costList>
			<Steel>30</Steel>
			<Silver>5</Silver>
		</costList>
		<statBases>
			<WorkToMake>2500</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<MedicalTendSpeed>0.1</MedicalTendSpeed>
			<MedicalTendQuality>0.15</MedicalTendQuality>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/MedicBelt/MedicBelt</wornGraphicPath>
			<tags>
				<li>BNFII_MedicAccessories</li>
			</tags>
		</apparel>
	</ThingDef>

</Defs>
