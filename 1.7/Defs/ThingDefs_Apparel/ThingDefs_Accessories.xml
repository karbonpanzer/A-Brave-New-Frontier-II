<?xml version='1.0' encoding='utf-8'?>
<Defs>

	<!-- Accessory Parent -->
	<ThingDef Name="BNFII_AccessoryBase" ParentName="ApparelMakeableBase" Abstract="True">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>1</Mass>
			<StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Waist</li>
			</bodyPartGroups>
			<layers>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<useWornGraphicMask>True</useWornGraphicMask>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.50,0.5,0.36)</only>
				</li>
				<li>
					<weight>6</weight>
					<only>(0.40,0.57,0.40)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.38,0.36,0.20)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.29,0.32,0.12)</only>
				</li>
			</options>
		</colorGenerator>
		<thingCategories Inherit="False">
			<li>ApparelMisc</li>
		</thingCategories> 		
		<tradeTags>
			<li>Clothing</li>
			<li>BNFII_Utility</li>
		</tradeTags>
	</ThingDef>

	<!-- Webbing -->
	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_WebbingAmmo</defName>
		<label>ammo webbing</label>
		<description>.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_InfantryKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/HeavyInfantryBandoleer/HeavyInfantryBandoleer</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<RangedCooldownFactor>-0.35</RangedCooldownFactor>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/HeavyInfantryBandoleer/HeavyInfantryBandoleer</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_InfantryAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_WebbingScout</defName>
		<label>scout webbing</label>
		<description>.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_ScoutKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/ScoutWebbing/ScoutWebbing</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<HuntingStealth>0.40</HuntingStealth>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/ScoutWebbing/ScoutWebbing</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_ScoutAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BNFII_AccessoryBase">
		<defName>BNFII_WebbingShocktrooper</defName>
		<label>shocktrooper webbing</label>
		<description>.</description>
		<recipeMaker>
			<researchPrerequisite>BNFII_ShocktrooperKit</researchPrerequisite>
		</recipeMaker>
		<graphicData>
			<texPath>BNFII/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</texPath>
		</graphicData>
		<costList>
			<Steel>40</Steel>
		</costList>
		<statBases>
			<WorkToMake>10000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<PainShockThreshold>0.20</PainShockThreshold>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>BNFII/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</wornGraphicPath>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<tags>
				<li>BNFII_ShocktrooperAccessories</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>28</layer>
				</dataNorth>
			</drawData>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>8</maxCharges>
				<ammoDef>Weapon_GrenadeFrag</ammoDef>
				<ammoCountToRefill>1</ammoCountToRefill>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>frag</chargeNoun>
				<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li>
				<label>throw frag grenade</label>
				<verbClass>Verb_LaunchProjectileStatic</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<onlyManualCast>True</onlyManualCast>
				<range>12.9</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<warmupTime>1.5</warmupTime>
				<noiseRadius>4</noiseRadius>
				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
				<soundCast>ThrowGrenade</soundCast>
				<drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>Proj_GrenadeFrag</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
	</ThingDef>

	<!-- Pouches -->
