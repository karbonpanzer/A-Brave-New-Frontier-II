<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Uniform Parents -->
  <ThingDef Name="BNFII_ApparelUniformBase" ParentName="ApparelMakeableBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>BNFII_Uniforms</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BNFII_Clothing</li>
    </tradeTags>
  </ThingDef>

  <ThingDef Name="BNFII_ApparelHatBase" ParentName="HatMakeableBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.2</drawSize>
    </graphicData>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <Mass>0.1</Mass>
      <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>BNFII_Headgear</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BNFII_Clothing</li>
    </tradeTags>
  </ThingDef>

  <!-- Temperate Uniform -->
  <ThingDef ParentName="BNFII_ApparelUniformBase">
    <defName>BNFII_FieldUniform_Temperate</defName>
    <label>frontier uniform (temperate)</label>
    <description>.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Clothes/FieldUniformTemperate/FieldUniformTemperate</texPath>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.50,0.5,0.36)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.40,0.57,0.40)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.38,0.36,0.20)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.29,0.32,0.12)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>BNFII_FrontierUniforms</researchPrerequisite>
    </recipeMaker>
    <costStuffCount>70</costStuffCount>
    <statBases>
      <WorkToMake>4200</WorkToMake>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>1.8</Mass>
      <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <PainShockThreshold>0.10</PainShockThreshold>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Clothes/FieldUniformTemperate/FieldUniformTemperate</wornGraphicPath>
      <tags>
        <li>BNFII_Uniform</li>
      </tags>
    </apparel>
  </ThingDef>

