  <!-- Flak Armor -->
  <ThingDef ParentName="BNFII_FlakArmorBase">
    <defName>BNFII_FlakArmor</defName>
    <label>flak armor</label>
    <description>A full set of armor plates, covering most of the body. Using a mixture of plasteel weave and metals, it provides good protection against gunshots and stabbing attacks.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/FlakArmor/FlakArmor</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>BNFII_FlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Steel>80</Steel>
    </costList>
    <equippedStatOffsets>
      <MoveSpeed>-0.14</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <MarketValue>550</MarketValue>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>7.0</Mass>
      <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.44</ArmorRating_Blunt>
      <ArmorRating_Heat>0.33</ArmorRating_Heat>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/FlakArmor/FlakArmor</wornGraphicPath>
      <tags>
        <li>BNFII_FlakArmor</li>
      </tags>
    </apparel>
  </ThingDef>

