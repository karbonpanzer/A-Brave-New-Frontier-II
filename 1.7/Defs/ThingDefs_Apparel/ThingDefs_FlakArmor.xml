    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/FlakArmor/FlakArmor</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>BNFII_FlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
