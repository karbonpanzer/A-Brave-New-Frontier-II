<?xml version='1.0' encoding='utf-8'?>
<Defs> 

  <!-- Officer Flak Armor -->
  <ThingDef ParentName="BNFII_FlakArmorBase">
    <defName>BNFII_OfficerFlakArmor</defName>
    <label>officer flak armor</label>
    <description>A full set of armor plates, covering most of the body. Using a mixture of plasteel weave, metals and gold, it provides good protection against gunshots and stabbing attacks while projecting their Officer status.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/OfficerFlakArmor/OfficerFlakArmor</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>BNFII_OfficerFlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>30</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Gold>8</Gold>
    </costList>
    <costStuffCount>100</costStuffCount>
    <equippedStatOffsets>
      <MoveSpeed>-0.05</MoveSpeed>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
      <PsychicSensitivity MayRequire="Ludeon.RimWorld.Royalty">0.05</PsychicSensitivity>
      <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.033</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>12000</WorkToMake>
      <MarketValue>1000</MarketValue>
      <MaxHitPoints>265</MaxHitPoints>
      <Mass>10.0</Mass>
      <StuffEffectMultiplierArmor>1.15</StuffEffectMultiplierArmor>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/OfficerFlakArmor/OfficerFlakArmor</wornGraphicPath>
      <tags>
        <li>BNFII_OfficerFlakArmor</li>
        <li MayRequire="Ludeon.RimWorld.Royalty">PrestigeCombatGear</li>
      </tags>
    </apparel>
  </ThingDef>

