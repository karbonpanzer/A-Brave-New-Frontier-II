<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Heavy Flak Armor -->
  <ThingDef ParentName="BNFII_FlakArmorBase">
    <defName>BNFII_HeavyFlakArmor</defName>
    <label>heavy flak armor</label>
    <description>A reinforced full set of armor plates, covering the body but heavier than normal flak armor. Additional layers of plasteel weave and metal offer improved protection but the additional weight slows the wearer.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakArmor</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>BNFII_HeavyFlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>30</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <costStuffCount>100</costStuffCount>
    <equippedStatOffsets>
      <MoveSpeed>-0.07</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>10000</WorkToMake>
      <MarketValue>800</MarketValue>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>12.0</Mass>
      <StuffEffectMultiplierArmor>1.25</StuffEffectMultiplierArmor>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakArmor</wornGraphicPath>
      <tags>
        <li>BNFII_HeavyFlakArmor</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="BNFII_FlakHelmetBase">
