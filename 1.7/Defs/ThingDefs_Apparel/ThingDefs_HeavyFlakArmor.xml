      <texPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakHelmet</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>BNFII_HeavyFlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Cloth>10</Cloth>
    </costList>
    <costStuffCount>50</costStuffCount>
    <equippedStatOffsets>
      <MoveSpeed>-0.02</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>7000</WorkToMake>
      <MaxHitPoints>110</MaxHitPoints>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>1.20</StuffEffectMultiplierArmor>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakHelmet</wornGraphicPath>
      <tags>
        <li>BNFII_HeavyFlakArmor</li>
        <li>BNFII_HeavyFlakHelmet</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="BNFII_FlakHelmetBase">
    <defName>BNFII_HeavyFlakHelmet_Thermal</defName>
    <label>heavy insulated flak helmet</label>
    <description>A reinforced combat helmet, using a different design which provides greater protection than simple flak helmets. However the additional armor slows the wearer. Fitted with an insulated hood which keeps the wearer's head warm.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakHelmetThermal</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisites>
        <li>BNFII_ModifiedFlakHelmets</li>
        <li>BNFII_HeavyFlakArmor</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList Inherit="False">
      <Cloth>100</Cloth>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <costStuffCount>50</costStuffCount>
    <equippedStatOffsets>
      <MoveSpeed>-0.02</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>1.20</StuffEffectMultiplierArmor>
      <EquipDelay>5</EquipDelay>
      <Insulation_Cold>12</Insulation_Cold>
      <Insulation_Heat>0.2</Insulation_Heat>
      <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakHelmetThermal</wornGraphicPath>
      <layers Inherit="False">
        <li>Overhead</li>
      </layers>
      <bodyPartGroups Inherit="False">
        <li>FullHead</li>
      </bodyPartGroups>
      <tags>
        <li>BNFII_HeavyFlakArmor</li>
        <li>BNFII_HeavyFlakHelmetThermal</li>
      </tags>
    </apparel>
  </ThingDef>

