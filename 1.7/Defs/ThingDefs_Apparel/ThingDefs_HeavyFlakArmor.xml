<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Heavy Flak Armor -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>BNFII_HeavyFlakArmor</defName>
    <label>heavy flak armor</label>
    <description>.</description>
    <graphicData>
      <texPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <colorGenerator Class="ColorGenerator_StandardApparel"/>
    <recipeMaker>
      <researchPrerequisite>BNFII_HeavyFlakArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>30</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <equippedStatOffsets>
      <MoveSpeed>-0.07</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>10000</WorkToMake>
      <MarketValue>800</MarketValue>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>12.0</Mass>
      <StuffEffectMultiplierArmor>1.25</StuffEffectMultiplierArmor>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>BNFII/Things/Pawn/Humanlike/Armor/HeavyFlakArmor/HeavyFlakArmor</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Neck</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <tags Inherit="False">
        <li>BNFII_Armor_Heavy</li>
        <li>BNFII_Armor_Heavy_Shocktrooper</li>
      </tags>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>BNFII_Armor</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
      <li>BNFII_Armor</li>
    </tradeTags>
  </ThingDef>

