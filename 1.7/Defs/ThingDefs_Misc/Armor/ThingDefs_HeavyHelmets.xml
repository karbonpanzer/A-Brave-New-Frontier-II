<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>KP_Heavy_Flak_Helmet</defName>
    <label>Heavy Carapace Helmet</label>
    <description>An improvement in the previous design of Carapace Helmets though never popularly adopted due to the Fall of the Great Domain.  Providing great protection without becoming cumbersome, the Heavy Carapace Helmet is now stronger and more durable without sacrificing comfort for protection. This was achieved through advancements in plasteel plating, providing greater protection without adding too much weight. Though lacking the larger stores of its lighter brethren, the Heavy Carapace Helmet has become more popular with heavy infantry and shocktrooper regiments throughout the Rim.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Helmets/HeavyHelmet/HeavyHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisite>HeavyFlakArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Cloth>60</Cloth>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <WorkToMake>7000</WorkToMake>
      <MaxHitPoints>110</MaxHitPoints>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>1.20</StuffEffectMultiplierArmor>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.02</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Helmets/HeavyHelmet/HeavyHelmet</wornGraphicPath>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <useWornGraphicMask>True</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <tags Inherit="False">
        <li>BNF_Armor_Heavy</li>
      </tags>
      <renderNodeProperties>
        <li Class="BNF.Core.DecalSystem.PawnRenderNodePropertiesOmni">
          <nodeClass>BNF.Core.DecalSystem.PawnRenderNodeDecal</nodeClass>
          <workerClass>BNF.Core.DecalSystem.PawnRenderNodeWorkerHeadware</workerClass>
          <parentTagDef>ApparelHead</parentTagDef>
          <baseLayer>55</baseLayer>
          <texPaths>
            <li>Things/Decals/Infantry/None</li>
          </texPaths>
          <visibleFacing>
            <li>South</li>
            <li>North</li>
          </visibleFacing>
          <drawData>
            <scale>0.100</scale>
            <defaultData>
              <layer>75</layer>
              <offset>(0,0,0.17)</offset>
              <flip>true</flip>
            </defaultData>
          </drawData>
        </li>
      </renderNodeProperties>
    </apparel>
    <comps>
      <li Class="BNF.Core.DecalSystem.CompPropertiesEditDecalMarker" />
    </comps>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>BNF_Helmets</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
      <li>BNF_Armor</li>
    </tradeTags>
