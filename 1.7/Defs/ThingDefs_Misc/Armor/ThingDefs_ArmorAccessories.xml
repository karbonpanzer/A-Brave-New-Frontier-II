<Defs>

	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>KP_Armored_Boots</defName>
		<label>Carapace Greaves</label>
		<description>The initial run of Carapace Armor often had protection for the thighs of soldiers but did not protect the leg from the knee down. This was chosen because of the need to keep soldiers mobile and moving fast. After decades of fighting Mechanoids and Insectoids in addition to humanity, the battle-smiths of the planet of Hastings created the Carapace Greaves. Built to the same standard of Carapace Armor, which allows protection but has the trade-off of heavy equipment slowing down soldiers, though the Dragonguard of Hastings preferred the heavy armor over nothing.</description>
		<techLevel>Industrial</techLevel>
		<recipeMaker>
			<researchPrerequisite>LateIndustrialFlakArmor</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="false">
				<li>TableMachining</li>
			</recipeUsers>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Armor/ArmoredBoots/ArmoredBoots</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>2</uiIconScale>
		<statBases>
			<WorkToMake>5000</WorkToMake>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>80</MaxHitPoints>
			<Mass>2.5</Mass>
			<StuffEffectMultiplierArmor>1.00</StuffEffectMultiplierArmor>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.10</MoveSpeed>
		</equippedStatOffsets>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
		<thingCategories>
			<li>BNF_ArmorAccessories</li>
		</thingCategories>
		<costList>
			<Cloth>10</Cloth>
			<Plasteel>5</Plasteel>
		</costList>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>10</costStuffCount>
		<apparel>
			<bodyPartGroups>
				<li>Feet</li>
				<li>Legs</li>				
			</bodyPartGroups>
			<useWornGraphicMask>True</useWornGraphicMask>
			<layers>
				<li>Middle</li>
			</layers>
			<tags>
				<li>BNF_Armor_Light</li>
                <li>BNF_Armor_Heavy</li>
				<li>BNF_Armor_Light_Medic</li>
				<li>BNF_Armor_Heavy_Medic</li>
