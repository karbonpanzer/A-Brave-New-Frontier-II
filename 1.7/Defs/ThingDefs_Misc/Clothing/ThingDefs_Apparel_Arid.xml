<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>KP_Field_Uniform_Desert</defName>
    <label>Frontier Uniform (Arid)</label>
    <description>From the dense jungles to the dry deserts, this uniform is designed to be proficient at both. While being made from common textiles, it retains a composition that allows a high level of comfort in any form of heat. This was initially used on the Spiceworlds of the Great Domain, the planets themselves being low static desert worlds perfect to produce advanced circuitry needed for the first generation of Mechanoids. While the Great Domain has fallen, this uniforms remains as a memory of a time long past, when humanity dominated all worlds they encountered.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Pawn/Humanlike/Clothes/FieldUniformDesert/FieldUniformDesert</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>0.8</drawSize>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.75,0.67,0.54)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.55,0.45,0.46)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.56,0.43,0.24)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>LateIndustrialUniforms</researchPrerequisite>
    </recipeMaker>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>70</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>4200</WorkToMake>
      <Mass>1.8</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>1.0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <PainShockThreshold>0.10</PainShockThreshold>
    </equippedStatOffsets>
    <apparel>
      <developmentalStageFilter>Child,Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Clothes/FieldUniformDesert/FieldUniformDesert</wornGraphicPath>
      <useWornGraphicMask>True</useWornGraphicMask>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>BNF_Uniform</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>KP_Uniforms</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BNF_Clothing</li>
    </tradeTags>
  </ThingDef>

	<ThingDef ParentName="HatMakeableBase">
    <defName>KP_Field_Hat_Desert</defName>
    <label>Field Hat (Arid)</label>
    <description>Based on an Old Earth design from the 3rd Era of Imperialism. This headgear is designed to protect the wearer from the worst heat they can find in the Rim. Providing not only cool headwear but also protecting the wearer from the worst that the sun can provide. Originally designed for usage on Spiceworld Regiments, it is now found in more worlds than the uniform that it came from.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Headgear/FieldHatDesert/FieldHatDesert</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.2</drawSize>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.50,0.5,0.36)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.40,0.57,0.40)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.38,0.36,0.20)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.29,0.32,0.12)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>LateIndustrialUniforms</researchPrerequisite>
    </recipeMaker>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>35</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>1600</WorkToMake>
      <Mass>0.1</Mass>
      <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
    <apparel>
      <developmentalStageFilter>Child,Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Headgear/FieldHatDesert/FieldHatDesert</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>BNF_Uniform</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <useWornGraphicMask>True</useWornGraphicMask>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>KP_Headgear</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BNF_Clothing</li>
    </tradeTags>
  </ThingDef>
</Defs>
