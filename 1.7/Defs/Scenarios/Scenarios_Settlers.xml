<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ScenarioDef ParentName="ScenarioBase">
		<defName>BNFII_Colony</defName>
		<label>Settlers</label>
		<description>After finding a place of strategic importance, your group chose to embark to set the claim for this land. With the backing of the government, you will hold this land as a settlement and administer to it as you see fit.</description>

		<scenario>
			<name>Settlers</name>
			<summary>Three settlers try and make it work - a twist on the classic Rimworld experience.</summary>
			<description>After finding a place of strategic importance, your group chose to embark to set the claim for this land. With the backing of the government, you will hold this land as a settlement and administer to it as you see fit.</description>

			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>BNFII_Frontier_Player</factionDef>
			</playerFaction>

			<parts>
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>After finding a place of strategic importance, your group chose to embark to set the claim for this land.\n\nWith the backing of the government, you will hold this land as a settlement and administer to it as you see fit.</text>
					<closeSound>GameStartSting</closeSound>
				</li>			
			
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>3</pawnCount>
					<pawnChoiceCount>8</pawnChoiceCount>
				</li>

				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>DropPods</method>
					<visible>false</visible>
				</li>

				<li Class="ScenPart_ForcedHediff">
					<def>ForcedHediff</def>
					<visible>false</visible>
					<context>PlayerStarter</context>
					<chance>0.5</chance>
					<hediff>CryptosleepSickness</hediff>
					<hideOffMap>true</hideOffMap>
					<severityRange>1~1</severityRange>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_TrenchShotgun</thingDef>
					<quality>Normal</quality>
				</li>
				
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_ServiceRifle</thingDef>
					<count>1</count>					
					<quality>Normal</quality>
				</li>				

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_TrenchKnife</thingDef>
					<count>2</count>
					<stuff>Steel</stuff>
					<quality>Normal</quality>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_FlakArmor</thingDef>
					<count>1</count>
					<stuff>Steel</stuff>
					<quality>Normal</quality>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_FlakGloves</thingDef>
					<count>1</count>
					<stuff>Steel</stuff>
					<quality>Normal</quality>
				</li>	

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_FlakBoots</thingDef>
					<count>1</count>
					<stuff>Steel</stuff>
					<quality>Normal</quality>
				</li>					

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>BNFII_FlakHelmet</thingDef>
					<count>1</count>
					<stuff>Steel</stuff>
					<quality>Normal</quality>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>400</count>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>150</count>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>40</count>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>60</count>
				</li>

				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Steel</thingDef>
					<count>200</count>
				</li>
				
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>WoodLog</thingDef>
					<count>300</count>
				</li>				
				
				<li Class="ScenPart_StartingResearch">
				  <def>StartingResearch</def>
				  <project>BNFII_FrontierUniforms</project>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>
</Defs>
